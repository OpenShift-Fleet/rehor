  "dependencies": {
    "@gitbeaker/requester-utils": "44.0.5",
    "@gitbeaker/rest": "44.0.5",
    "@octokit/graphql": "9.0.5",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@octokit/rest": "22.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
