# Agent Dispatcher (REHOR-204)
#
# Built by the Konflux platform-frontend-ai-dev-agent-dispatcher component
# (dockerfile: packages/agent-dispatcher/Containerfile, path-context: ./).
# The npm workspace build requires the repository root as build context.
# Compile on the builder's native architecture, regardless of target platform.
# Dependencies are installed offline from the lockfile and prefetched npm cache.
#
# The dispatcher's only preflight path is the TS engine (REHOR-259): the
# @rehor/preflights workspace package executes declarative instance.yaml
# configuration in-process. No Python, no MCP client, and no gh/glab executor
# shims are installed — the removed Python preflight runner was their only
# consumer. Git stays: config repositories are still cloned, but they now
# supply data (instance.yaml, project-repos.json), never executed code.

FROM --platform=${BUILDPLATFORM} registry.access.redhat.com/ubi9/nodejs-22:latest@sha256:a8322d320e7409c42cc730e0a1a489fb185bc9f688c8d27613d83ffd658f16bd AS builder
USER 0
WORKDIR /app

COPY package.json package-lock.json nx.json ./
COPY packages/agent-dispatcher/package.json packages/agent-dispatcher/tsconfig.json packages/agent-dispatcher/project.json packages/agent-dispatcher/
COPY packages/preflights/package.json packages/preflights/tsconfig.json packages/preflights/project.json packages/preflights/
COPY packages/openshell-sdk packages/openshell-sdk
RUN npm ci --offline --no-audit --ignore-scripts

COPY packages/agent-dispatcher/src packages/agent-dispatcher/src
COPY packages/preflights/src packages/preflights/src
RUN npm run build --workspace=@rehor/agent-dispatcher

# npm links the local SDK workspace from node_modules/@nvidia/openshell-sdk to
# /app/packages/openshell-sdk, and @rehor/preflights from
# node_modules/@rehor/preflights to /app/packages/preflights. Keep those paths
# in the production dependency stage and final image so the workspace links
# remain valid at runtime.
FROM registry.access.redhat.com/ubi9/nodejs-22:latest@sha256:a8322d320e7409c42cc730e0a1a489fb185bc9f688c8d27613d83ffd658f16bd AS dependencies
USER 0
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/agent-dispatcher/package.json packages/agent-dispatcher/
COPY packages/preflights/package.json packages/preflights/
COPY packages/openshell-sdk packages/openshell-sdk
RUN npm ci --workspace=@rehor/agent-dispatcher --omit=dev --offline --no-audit --ignore-scripts

# Runtime dependencies come from the Node.js base image, which ships the Git
# the config-repository synchronization needs. Nothing else is installed.
FROM registry.access.redhat.com/ubi9/nodejs-22:latest@sha256:a8322d320e7409c42cc730e0a1a489fb185bc9f688c8d27613d83ffd658f16bd
USER 0
WORKDIR /app
COPY --from=dependencies --chown=1001:0 /app/node_modules ./node_modules
COPY --from=dependencies --chown=1001:0 /app/packages/openshell-sdk ./packages/openshell-sdk
COPY --from=dependencies --chown=1001:0 /app/packages/agent-dispatcher ./packages/agent-dispatcher
COPY --from=dependencies --chown=1001:0 /app/packages/preflights ./packages/preflights
COPY --from=builder --chown=1001:0 /app/packages/agent-dispatcher/dist ./packages/agent-dispatcher/dist
COPY --from=builder --chown=1001:0 /app/packages/preflights/dist ./packages/preflights/dist
USER 1001
CMD ["node", "packages/agent-dispatcher/dist/index.js"]
