{
  "name": "@rehor/coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rehor-coordinator": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.272",
    "@opencode-ai/sdk": "1.18.29",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
