{
  "name": "@rehor/agent-dispatcher",
  "projectType": "application",
  "sourceRoot": "packages/agent-dispatcher/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "packages/agent-dispatcher"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node --import ./test/register-sdk-hook.mjs --test test/*.test.mjs",
        "cwd": "packages/agent-dispatcher"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "npm run start --workspace=@rehor/agent-dispatcher"
      }
    }
  }
}
